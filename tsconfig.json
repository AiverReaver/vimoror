{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // `apps/editor` is the repo's first UI surface. React 19's automatic runtime
    // means no component file imports React just to use JSX; esbuild reads this
    // same setting when Vite transpiles, so the two agree without a second knob.
    "jsx": "react-jsx"
  },
  "include": ["packages/**/*.ts", "tools/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "vitest.config.ts", "playwright.config.ts"]
}
