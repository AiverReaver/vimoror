[
  {
    "id": "excmd/delete-current-line-default-range",
    "buffer": [
      "one",
      "two",
      "three"
    ],
    "cursor": [
      2,
      1
    ],
    "keys": ":d<CR>",
    "groups": [
      ":d<CR>"
    ],
    "note": "no range given — :d acts on the current line only, like dd",
    "encodedKeys": ":d\r",
    "expect": {
      "registers": {
        "1": {
          "type": "V",
          "text": "two\n"
        },
        "\"": {
          "type": "V",
          "text": "two\n"
        }
      },
      "buffer": [
        "one",
        "three"
      ],
      "cursor": [
        2,
        1
      ],
      "error": "",
      "curswant": 1
    }
  },
