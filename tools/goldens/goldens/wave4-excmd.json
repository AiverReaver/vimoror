  {
    "id": "excmd/normal-no-range-auto-exits-insert",
    "buffer": [
      "abc"
    ],
    "cursor": [
      1,
      1
    ],
    "keys": ":normal Azzz<CR>x",
    "groups": [
      ":normal Azzz<CR>x"
    ],
    "note": "Vim exits Insert/Replace/Visual automatically at the end of :normal, \"as if <Esc> was typed\" (:help :normal) — there is no way to embed a literal <Esc> in the argument anyway, since pressing Esc at the : prompt cancels the whole command line before it runs. The trailing x is the observable proof: if :normal left the engine stuck in insert mode, x would insert a literal \"x\" instead of deleting the character under the cursor.\n",
    "encodedKeys": ":normal Azzz\rx",
    "expect": {
      "registers": {
        "\"": {
          "type": "v",
          "text": "z"
        },
        "-": {
          "type": "v",
          "text": "z"
        }
      },
      "buffer": [
        "abczz"
      ],
      "cursor": [
        1,
        5
      ],
      "error": "",
      "curswant": 5
    }
  },
