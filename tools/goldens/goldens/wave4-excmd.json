  {
    "id": "excmd/visual-range-delete-via-colon",
    "buffer": [
      "one",
      "two",
      "three",
      "four"
    ],
    "cursor": [
      1,
      1
    ],
    "keys": "Vj:d<CR>",
    "groups": [
      "Vj:d<CR>"
    ],
    "note": "pressing : from visual mode auto-fills '<,'> on the command line, exactly like real Vim — the typed keys are just Vj:d<CR>, nothing types the \"'<,'>\" text itself\n",
    "encodedKeys": "Vj:d\r",
    "expect": {
      "registers": {
        "1": {
          "type": "V",
          "text": "one\ntwo\n"
        },
        "\"": {
          "type": "V",
          "text": "one\ntwo\n"
        }
      },
      "buffer": [
        "three",
        "four"
      ],
      "cursor": [
        1,
        1
      ],
      "error": "",
      "curswant": 1
    }
  },
  {
    "id": "excmd/dot-repeat-is-not-contaminated-by-ex-command",
    "buffer": [
      "aaa",
      "bbb"
    ],
    "cursor": [
      1,
      1
    ],
    "keys": "x:d<CR>.",
    "groups": [
      "x",
      ":d<CR>",
      "."
    ],
    "note": "regression for the recordChange guard: . after an ex command must still repeat the last NORMAL-mode change (x), never the :d<CR> itself — real Vim has no notion of dot-repeating an ex command at all\n",
    "encodedKeys": "x:d\r.",
    "expect": {
      "registers": {
        "1": {
          "type": "V",
          "text": "aa\n"
        },
        "\"": {
          "type": "v",
          "text": "b"
        },
        "-": {
          "type": "v",
          "text": "b"
        }
      },
      "buffer": [
        "bb"
      ],
      "cursor": [
        1,
        1
      ],
      "error": "",
      "curswant": 1
    }
  }
]
