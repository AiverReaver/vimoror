  {
    "id": "excmd/bare-colon-goes-to-next-line",
    "buffer": [
      "one",
      "two"
    ],
    "cursor": [
      1,
      2
    ],
    "keys": ":<CR>",
    "groups": [
      ":<CR>"
    ],
    "note": "a truly empty command line is NOT a no-op — measured against real Vim in isolation (a fresh, unbatched process, to rule out a leftover-command artifact): it advances one line, the classic ex convention of a bare <CR> meaning \"current line + 1\"\n",
    "encodedKeys": ":\r",
    "expect": {
      "registers": {},
      "buffer": [
        "one",
        "two"
      ],
      "cursor": [
        2,
        1
      ],
      "error": "",
      "curswant": 1
