        "aa",
        "aa",
        "aa"
      ],
      "cursor": [
        3,
        1
      ],
      "error": "",
      "curswant": 1
    }
  },
  {
    "id": "excmd/normal-with-range-survives-line-count-shrinking",
    "buffer": [
      "one",
      "two",
      "three",
      "four"
    ],
    "cursor": [
      1,
      1
    ],
    "keys": ":1,2normal dd<CR>",
    "groups": [
      ":1,2normal dd<CR>"
    ],
    "note": "each dd changes the line count out from under the remaining targets — this is what actually exercises the shift-adjustment, unlike the char-delete case above where the line count never moves\n",
    "encodedKeys": ":1,2normal dd\r",
    "expect": {
      "registers": {
        "1": {
          "type": "V",
          "text": "three\n"
        },
        "2": {
          "type": "V",
          "text": "one\n"
        },
        "\"": {
          "type": "V",
          "text": "three\n"
        }
      },
      "buffer": [
        "two",
        "four"
      ],
      "cursor": [
        2,
        1
      ],
      "error": "",
      "curswant": 1
    }
  },
  {
    "id": "excmd/normal-with-range-can-empty-the-buffer",
    "buffer": [
      "aaa",
      "bbb",
      "ccc"
    ],
    "cursor": [
      1,
      1
    ],
    "keys": ":1,3normal dd<CR>",
    "groups": [
      ":1,3normal dd<CR>"
    ],
    "note": "deleting every targeted line still leaves one empty line, the same floor :%d hits",
    "encodedKeys": ":1,3normal dd\r",
    "expect": {
      "registers": {
        "1": {
          "type": "V",
          "text": "bbb\n"
        },
        "2": {
          "type": "V",
          "text": "ccc\n"
        },
        "3": {
          "type": "V",
          "text": "aaa\n"
        },
        "\"": {
          "type": "V",
          "text": "bbb\n"
        }
      },
      "buffer": [
        ""
      ],
      "cursor": [
        1,
        1
      ],
      "error": "",
      "curswant": 1
    }
  },
