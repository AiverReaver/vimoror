  {
    "id": "search/star-searches-whole-word",
    "buffer": [
      "a cat sat on concatenate"
    ],
    "cursor": [
      1,
      3
    ],
    "keys": "*",
    "groups": [
      "*"
    ],
    "note": "`cat` inside `concatenate` must NOT match — `*` wraps `\\<...\\>`",
    "encodedKeys": "*",
    "expect": {
      "registers": {
        "/": {
          "type": "v",
          "text": "\\<cat\\>"
        }
      },
      "buffer": [
        "a cat sat on concatenate"
      ],
      "cursor": [
        1,
        3
      ],
      "error": "",
      "curswant": 3
    }
