  {
    "id": "search/forward-lands-on-match-start",
    "buffer": [
      "alpha beta gamma"
    ],
    "cursor": [
      1,
      1
    ],
    "keys": "/gamma<CR>",
    "groups": [
      "/gamma<CR>"
    ],
    "encodedKeys": "/gamma\r",
    "expect": {
      "registers": {
        "/": {
          "type": "v",
          "text": "gamma"
        }
      },
      "buffer": [
        "alpha beta gamma"
      ],
      "cursor": [
        1,
        12
      ],
      "error": "",
      "curswant": 12
    }
  },
