      "b pat",
      "c pat",
      "d pat",
      "e pat"
    ],
    "cursor": [
      1,
      1
    ],
    "keys": ":2,4g/pat/d<CR>",
    "groups": [
      ":2,4g/pat/d<CR>"
    ],
    "note": "contrast with the default-range case above — only lines 2-4 are candidates",
    "encodedKeys": ":2,4g/pat/d\r",
    "expect": {
      "registers": {
        "1": {
          "type": "V",
          "text": "d pat\n"
        },
        "2": {
          "type": "V",
          "text": "c pat\n"
        },
        "3": {
          "type": "V",
          "text": "b pat\n"
        },
        "\"": {
          "type": "V",
          "text": "d pat\n"
        },
        "/": {
          "type": "v",
          "text": "pat"
        }
      },
      "buffer": [
        "a pat",
        "e pat"
      ],
      "cursor": [
        2,
        1
      ],
      "error": "",
      "curswant": 1
    }
  },
  {
    "id": "global/v-inverts-the-match",
    "buffer": [
      "apple",
      "bar1",
      "banana",
      "bar2",
      "cherry",
      "baz3"
    ],
    "cursor": [
      1,
      1
    ],
    "keys": ":v/^b/d<CR>",
    "groups": [
      ":v/^b/d<CR>"
    ],
    "encodedKeys": ":v/^b/d\r",
    "expect": {
      "registers": {
        "1": {
          "type": "V",
          "text": "cherry\n"
        },
        "2": {
          "type": "V",
          "text": "apple\n"
        },
        "\"": {
          "type": "V",
          "text": "cherry\n"
        },
        "/": {
          "type": "v",
          "text": "^b"
        }
      },
      "buffer": [
        "bar1",
        "banana",
        "bar2",
        "baz3"
      ],
      "cursor": [
        4,
        1
      ],
      "error": "",
      "curswant": 1
    }
  },
  {
    "id": "global/gbang-inverts-identically-to-v",
    "buffer": [
      "apple",
      "bar1",
      "banana",
      "bar2",
      "cherry",
      "baz3"
    ],
    "cursor": [
      1,
      1
    ],
    "keys": ":g!/^b/d<CR>",
    "groups": [
      ":g!/^b/d<CR>"
    ],
    "note": "same buffer and net effect as the :v case above — :g! is byte-for-byte the same inversion",
    "encodedKeys": ":g!/^b/d\r",
    "expect": {
      "registers": {
        "1": {
          "type": "V",
          "text": "cherry\n"
        },
        "2": {
          "type": "V",
          "text": "apple\n"
        },
        "\"": {
          "type": "V",
          "text": "cherry\n"
        },
        "/": {
          "type": "v",
          "text": "^b"
        }
      },
      "buffer": [
        "bar1",
        "banana",
        "bar2",
        "baz3"
      ],
      "cursor": [
        4,
        1
      ],
      "error": "",
      "curswant": 1
    }
  },
  {
    "id": "global/scattered-deletes-prove-shift-tracking",
    "buffer": [
      "a",
      "b",
      "c",
      "d",
      "e"
    ],
    "cursor": [
      1,
      1
    ],
    "keys": ":g/[ace]/d<CR>",
    "groups": [
      ":g/[ace]/d<CR>"
    ],
    "note": "matched lines are non-adjacent (0, 2, 4) — each delete shrinks the buffer under the still-pending matches, so this only comes out right if the remaining matched-line set is kept in sync with every prior delete. Also the register-after-:g/d case: numbered registers shift exactly like three independent :d presses (last-deleted in \"1, first-deleted in \"3), which the comparator checks automatically.\n",
    "encodedKeys": ":g/[ace]/d\r",
    "expect": {
      "registers": {
        "1": {
          "type": "V",
          "text": "e\n"
        },
        "2": {
          "type": "V",
          "text": "c\n"
        },
        "3": {
          "type": "V",
          "text": "a\n"
        },
        "\"": {
          "type": "V",
          "text": "e\n"
        },
        "/": {
          "type": "v",
          "text": "[ace]"
        }
      },
      "buffer": [
        "b",
        "d"
      ],
      "cursor": [
        2,
        1
      ],
      "error": "",
      "curswant": 1
    }
  },
  {
    "id": "global/body-substitute-failure-is-absorbed-per-line",
    "buffer": [
      "x1 nomatch",
      "y",
      "x2",
      "y",
      "x3 nomatch",
      "y",
      "x4"
    ],
    "cursor": [
      1,
      1
    ],
    "keys": ":g/x/s/nomatch/HIT/<CR>",
    "groups": [
      ":g/x/s/nomatch/HIT/<CR>"
    ],
    "note": "the body :s fails (E486) on every matched line that has no \"nomatch\" text — measured: :g absorbs that failure completely and keeps visiting every remaining matched line rather than aborting\n",
    "encodedKeys": ":g/x/s/nomatch/HIT/\r",
    "expect": {
      "registers": {
        "/": {
          "type": "v",
          "text": "nomatch"
        }
      },
      "buffer": [
        "x1 HIT",
        "y",
        "x2",
        "y",
        "x3 HIT",
        "y",
        "x4"
      ],
      "cursor": [
        7,
        1
      ],
      "error": "",
      "curswant": 1
    }
  },
  {
    "id": "global/body-normal-does-not-snap-cursor-back-to-match",
    "buffer": [
      "pat A",
      "xxx",
      "pat B",
      "yyy",
      "pat C",
      "zzz",
      "www"
    ],
    "cursor": [
      1,
      1
    ],
    "keys": ":g/pat/normal! j<CR>",
    "groups": [
      ":g/pat/normal! j<CR>"
    ],
    "note": "measured — the final cursor is wherever the LAST body invocation left it (one line below the last match, from its own \"j\"), not forced back onto that match line the way :g's own housekeeping would if it re-homed the cursor after the loop\n",
    "encodedKeys": ":g/pat/normal! j\r",
    "expect": {
      "registers": {
        "/": {
          "type": "v",
          "text": "pat"
        }
      },
      "buffer": [
        "pat A",
        "xxx",
        "pat B",
        "yyy",
        "pat C",
        "zzz",
        "www"
      ],
      "cursor": [
        6,
        1
      ],
      "error": "",
      "curswant": 1
    }
  },
  {
