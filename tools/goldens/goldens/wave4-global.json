[
  {
    "id": "global/default-range-is-whole-buffer",
    "buffer": [
      "foo pat one",
      "bar",
      "baz pat two",
      "qux",
      "pat end"
    ],
    "cursor": [
      2,
      1
    ],
    "keys": ":g/pat/d<CR>",
    "groups": [
      ":g/pat/d<CR>"
    ],
    "note": "no range prefix — :g acts on 1,$ regardless of where the cursor starts, unlike every other ex command in wave4-excmd.yaml, which defaults to the cursor's own line\n",
    "encodedKeys": ":g/pat/d\r",
    "expect": {
      "registers": {
        "1": {
          "type": "V",
          "text": "pat end\n"
        },
        "2": {
          "type": "V",
          "text": "baz pat two\n"
        },
        "3": {
          "type": "V",
          "text": "foo pat one\n"
        },
        "\"": {
          "type": "V",
          "text": "pat end\n"
        },
        "/": {
          "type": "v",
          "text": "pat"
        }
      },
      "buffer": [
        "bar",
        "qux"
      ],
      "cursor": [
        2,
        1
      ],
      "error": "",
      "curswant": 1
    }
  },
  {
    "id": "global/explicit-range-restricts-to-it",
    "buffer": [
