      1
    ],
    "keys": "/foo<CR>:g//d<CR>",
    "groups": [
      "/foo<CR>:g//d<CR>"
    ],
    "encodedKeys": "/foo\r:g//d\r",
    "expect": {
      "registers": {
        "1": {
          "type": "V",
          "text": "gamma2 foo\n"
        },
        "2": {
          "type": "V",
          "text": "delta1 foo\n"
        },
        "\"": {
          "type": "V",
          "text": "gamma2 foo\n"
        },
        "/": {
          "type": "v",
          "text": "foo"
        }
      },
      "buffer": [
        "beta"
      ],
      "cursor": [
        1,
        1
      ],
      "error": "",
      "curswant": 1
    }
  },
  {
