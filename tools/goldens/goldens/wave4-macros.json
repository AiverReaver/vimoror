  {
    "id": "macros/halt-on-error-mid-record-still-replays-past-it",
    "buffer": [
      "aaa",
      "bbb"
    ],
    "cursor": [
      1,
      1
    ],
    "keys": "qa`zxq@a",
    "groups": [
      "qa`zxq",
      "@a"
    ],
    "note": "recording never aborts, so \"a ends up holding the full `\\`zx` — but REPLAYING that content must halt at `\\`z (unset mark) and never reach x. Both groups genuinely raise E20 (an unset mark, not a mere beep), hence expectError\n",
    "expectError": true,
    "encodedKeys": "qa`zxq@a",
    "expect": {
      "registers": {
        "a": {
          "type": "v",
          "text": "`zx"
        },
        "\"": {
          "type": "v",
          "text": "a"
        },
        "-": {
          "type": "v",
          "text": "a"
        }
      },
      "buffer": [
        "a",
        "bbb"
      ],
      "cursor": [
        1,
        1
      ],
      "error": "Vim(call):E20: Mark not set | Vim(call):E20: Mark not set",
      "curswant": 1
    }
  },
