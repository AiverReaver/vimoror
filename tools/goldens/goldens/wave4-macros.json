      "3@a"
    ],
    "note": "3@a with a failing first command must leave EVERY repeat unrun, not just the first",
    "expectError": true,
    "encodedKeys": "qa`zA-\u001bq3@a",
    "expect": {
      "registers": {
        "a": {
          "type": "v",
          "text": "`zA-\u001b"
        }
      },
      "buffer": [
        "aaa----"
      ],
      "cursor": [
        1,
        7
      ],
      "error": "Vim(call):E20: Mark not set | Vim(call):E20: Mark not set",
      "curswant": 7
    }
