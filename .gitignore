node_modules/
dist/
*.tsbuildinfo
.DS_Store
.vite/
coverage/

# Playwright traces and failure artifacts. The specs themselves
# (apps/web/e2e/*.spec.ts) are committed; nothing it writes at run time is.
test-results/

# Scratch output from the golden harness. The goldens themselves
# (tools/goldens/goldens/*.json) ARE committed on purpose, so CI never
# needs Vim installed.
tools/goldens/.work/

# Output from graphify, a local analysis tool run against this repo. Not part
# of the project and not regenerated by anything here; ~1.5 MB of generated
# HTML/JSON that a broad `git add` would otherwise sweep into a commit.
graphify-out/
